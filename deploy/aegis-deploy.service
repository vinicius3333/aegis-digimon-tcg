[Unit]
Description=Aegis blue/green deployment reconciliation
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aegis-deploy/current
Environment=AEGIS_DEPLOY_ROOT=/var/lib/aegis-deploy
Environment=AEGIS_DEPLOY_COMPOSE=/opt/aegis-deploy/current/deploy/docker-compose.blue-green.yml
EnvironmentFile=-/etc/aegis-deploy/controller.env
ExecStart=/opt/aegis-deploy/current/deploy/aegis-deploy reconcile
