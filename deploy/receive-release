#!/bin/sh
set -eu

revision=${1:?revision is required}
api_image=${2:?api image is required}
web_image=${3:?web image is required}
archive=${4:?archive path is required}

case "$revision" in
  *[!0-9a-f]*|'') echo "Invalid revision" >&2; exit 1 ;;
esac
case "$api_image" in *@sha256:*) ;; *) echo "API image must use a digest" >&2; exit 1 ;; esac
case "$web_image" in *@sha256:*) ;; *) echo "Web image must use a digest" >&2; exit 1 ;; esac

install_root=${AEGIS_INSTALL_ROOT:-/opt/aegis-deploy}
release="$install_root/releases/$revision"
state_root=${AEGIS_DEPLOY_ROOT:-/var/lib/aegis-deploy}

mkdir -p "$release" "$state_root"
exec 9>"$state_root/deploy.lock"
flock -x 9

tar -xzf "$archive" -C "$release"
chmod 0755 "$release/deploy/aegis-deploy" "$release/deploy/receive-release" "$release/deploy/install.sh"
ln -sfn "$release" "$install_root/current.next"
mv -Tf "$install_root/current.next" "$install_root/current"
rm -f "$archive"

controller_config=${AEGIS_CONTROLLER_CONFIG:-/etc/aegis-deploy/controller.env}
if [ -f "$controller_config" ]; then
  set -a
  # Root-owned deployment configuration; values must use shell env-file syntax.
  . "$controller_config"
  set +a
fi

if [ ! -f "$state_root/state.json" ]; then
  : "${AEGIS_LEGACY_API_CONTAINER:?required for the first blue/green deployment}"
  : "${AEGIS_LEGACY_WEB_CONTAINER:?required for the first blue/green deployment}"
  exec node "$install_root/current/tools/blue-green-deploy.mjs" bootstrap \
    --revision "$revision" \
    --api-image "$api_image" \
    --web-image "$web_image" \
    --legacy-api-container "$AEGIS_LEGACY_API_CONTAINER" \
    --legacy-web-container "$AEGIS_LEGACY_WEB_CONTAINER"
fi

exec node "$install_root/current/tools/blue-green-deploy.mjs" deploy \
  --revision "$revision" \
  --api-image "$api_image" \
  --web-image "$web_image"
