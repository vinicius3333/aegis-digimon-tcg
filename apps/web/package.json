{
  "name": "@aegis/web",
  "version": "1.3.0-beta",
  "private": true,
  "description": "Aegis client: React + TypeScript + Vite. A pure function of synchronized state; sends intents, contains no rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:browser": "NODE_OPTIONS=--max-old-space-size=2048 pnpm --filter @aegis/shared build && NODE_OPTIONS=--max-old-space-size=2048 pnpm --filter @aegis/api exec tsc -p tsconfig.dev.json --noCheck && NODE_OPTIONS=--max-old-space-size=2048 playwright test"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "@colyseus/sdk": "^0.18.4",
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "colyseus": "^0.18.8",
    "jsdom": "^25.0.0",
    "typescript": "~7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "ws": "^8.18.0"
  }
}
