{
  "name": "@aegis/web",
  "version": "1.1.0",
  "private": true,
  "description": "Aegis client: React + TypeScript + Vite. A pure function of synchronized state; sends intents, contains no rules.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "colyseus.js": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "colyseus": "^0.16.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
