{
  "name": "@aegis/api",
  "version": "1.5.0-beta",
  "private": true,
  "description": "Aegis authoritative game server: Node + TypeScript + Colyseus. Owns 100% of game state and rules.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.dev.json --onSuccess \"node --enable-source-maps dist/index.js\"",
    "dev:fast": "tsc-watch -p tsconfig.dev.json --noCheck --onSuccess \"node --enable-source-maps dist/index.js\"",
    "build": "tsc --noCheck -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @aegis/shared build && vitest run",
    "test:fast": "FAST=1 vitest run",
    "test:watch": "FAST=1 vitest --passWithNoTests",
    "test:core": "FAST=1 vitest run --passWithNoTests",
    "test:cards": "vitest run --passWithNoTests src/cards/",
    "test:cards:bt10": "vitest run --config vitest.bt10.config.ts",
    "test:conformance": "vitest run --passWithNoTests src/engine/conformance --pool=forks --maxWorkers=1 --no-file-parallelism",
    "test:engine": "FAST=1 vitest run --passWithNoTests src/engine/",
    "test:verification": "vitest run src/engine/fuzzer.test.ts src/engine/setup.test.ts src/engine/testkit/stateInvariants.test.ts src/engine/testkit/harness.test.ts src/engine/state/visibility.test.ts src/bot/battleFuzzer.test.ts src/bot/matchHarness.projections.test.ts --pool=forks --maxWorkers=1 --no-file-parallelism",
    "bench:bot": "BOT_BENCH=1 vitest run src/bot/benchmark.test.ts",
    "fuzz:battles": "pnpm build && node dist/bot/battleFuzzerCli.js",
    "test:postgres": "POSTGRES_TESTS=1 vitest run src/db/postgres.atomicity",
    "test:parallel": "concurrently -n fast,cards 'pnpm test:fast' 'pnpm test:cards'"
  },
  "dependencies": {
    "@aegis/shared": "workspace:*",
    "@colyseus/redis-driver": "^0.18.3",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.3",
    "colyseus": "^0.18.8",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "5.0.1",
    "concurrently": "^10.0.0",
    "es-module-lexer": "^3.0.2",
    "esbuild": "^0.28.2",
    "oxc-transform": "^0.151.0",
    "pg-mem": "^3.0.14",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-api": "npm:typescript@~5.8.3",
    "vitest": "^5.0.1"
  }
}
