{
  "name": "@aegis/shared",
  "version": "1.1.0",
  "private": true,
  "description": "Aegis contract layer: shared TS types, card-data types, Colyseus state schema, and the client/server protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    },
    "./protocol/*": {
      "types": "./dist/protocol/*.d.ts",
      "default": "./dist/protocol/*.js"
    },
    "./cards/*": {
      "types": "./dist/cards/*.d.ts",
      "default": "./dist/cards/*.js"
    }
  },
  "scripts": {
    "dev": "tsc -w -p tsconfig.json",
    "build": "tsc -p tsconfig.json && pnpm run copy:data",
    "copy:data": "node scripts/copy-data.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~5.8.0",
    "vitest": "^5.0.0"
  }
}
