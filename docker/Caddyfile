# Served behind the host's dedicated edge Caddy (stagecast infra/Caddyfile.edge),
# which owns :80/:443 and terminates TLS for aegis-digi.online. This site is
# plain HTTP on :80 so it does not auto-HTTPS-redirect into a loop behind the edge.
:80 {
	encode gzip

	# One route per API process. Colyseus hands the client the public address of the process
	# that owns its room (`/p1`, `/p2`, `/p3`), so these paths must reach that process and no
	# other — a seat reservation is worthless on a sibling. handle_path strips the prefix, so
	# the process sees the URL it issued.
	handle_path /p1/* {
		reverse_proxy api:2567
	}
	handle_path /p2/* {
		reverse_proxy api2:2567
	}
	handle_path /p3/* {
		reverse_proxy api3:2567
	}

	@ws {
		header Connection *Upgrade*
		header Upgrade *websocket*
	}
	handle @ws {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /health {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /bot/* {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /room/* {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /matchmake/* {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /auth/* {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	handle /account/* {
		reverse_proxy api:2567 api2:2567 api3:2567
	}
	@tournament_api {
		path /tournaments*
		not header Accept *text/html*
	}
	handle @tournament_api {
		reverse_proxy api:2567 api2:2567 api3:2567
	}

	# Recovery endpoint for clients that retained HTML from an older release.
	# It clears only the caller's HTTP cache; cookies and local storage are preserved.
	handle /reset-web-cache {
		header Clear-Site-Data "\"cache\""
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		redir * / 303
	}

	@versioned_assets path_regexp versioned_assets /assets/.+-[A-Za-z0-9_-]+\.[A-Za-z0-9]+$
	handle @versioned_assets {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /usr/share/caddy
		file_server
	}

	@html path / /index.html
	handle @html {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		header Pragma "no-cache"
		header Expires "0"
		root * /usr/share/caddy
		rewrite * /index.html
		file_server
	}

	handle {
		header Cache-Control "no-cache, must-revalidate, max-age=0"
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
